<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item>
        <shape>
            <solid android:color="#B0B0B0"/> <!-- Warna Shadow -->
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Card Putih di Atas Shadow -->
    <item android:top="20dp" android:left="20dp" android:right="20dp" android:bottom="20dp"> <!-- Geser sedikit agar shadow terlihat -->
        <shape>
            <solid android:color="#FFFFFF"/> <!-- Warna Putih -->
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
