<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    tools:context=".HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Selamat Datang dan Profil -->
        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="16dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang, User!"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dark_purple"
                android:gravity="end"
                android:paddingEnd="10dp" />

            <ImageButton
                android:id="@+id/btnUserProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:src="@drawable/pp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="User Profile Button" />
        </LinearLayout>

        <!-- Header Background -->
        <View
            android:id="@+id/bgHeader"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_gradient" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Membantu Monitoring Pengiriman\nTabung Nitrogen"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-black"
            android:layout_marginTop="-160dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvGoTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GO TUBE"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <!-- Menu Card -->
        <!-- Card Menu -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="40dp"
            app:cardCornerRadius="7dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <ImageButton
                    android:id="@+id/btnDelivery"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/delivery"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delivery"/>

                <ImageButton
                    android:id="@+id/btnOutlet"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delivery"
                    android:padding="5dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/outlet" />

                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/history"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delivery"/>

                <ImageButton
                    android:id="@+id/btnNitro"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/nitro"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delivery"/>

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/profile"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delivery"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Riwayat Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="7dp"
            app:cardElevation="6dp"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titleRiwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIWAYAT AKTIVITAS"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/dark_purple" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/purple"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/lihatdetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Selengkapnya >"
                    android:textSize="14sp"
                    android:minHeight="30dp"
                    android:textColor="@color/dark_gray"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
