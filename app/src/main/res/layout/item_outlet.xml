<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- CardView Utama -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUtama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:baselineAligned="false"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNamaOutlet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Outlet: Outlet A"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Klik untuk lihat detail"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnEdit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    android:tint="@android:color/holo_orange_dark"
                    android:contentDescription="Edit" />

                <ImageButton
                    android:id="@+id/btnHapus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_delete"
                    android:tint="@android:color/holo_red_dark"
                    android:contentDescription="Hapus" />
            </LinearLayout>
        </LinearLayout> <!-- 🔧 Tambahkan ini -->
    </androidx.cardview.widget.CardView>

    <!-- CardView Detail -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Detail TextView -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama SPV:"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/tvNamaSPV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Supervisor A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Area:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvNamaArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Area A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merk Inflator:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvMerkInflator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merk A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merk Regulator:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvMerkRegulator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merk A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribusi To Outlet By:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvDistribusiBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distribusi Outlet By A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Vendor:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvNamaVendor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vendor A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harga Isi N2 To Outlet:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/tvHargaIsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120.000"
                android:textSize="14sp" />

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
